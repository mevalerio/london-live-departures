{
  "name": "london-live-departures",
  "productName": "London Live Departures",
  "version": "1.0.1",
  "description": "A beautiful, frameless desktop widget for live London Transport (TfL) and National Rail arrivals.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mevalerio/london-live-departures.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.github.london-live-departures",
    "publish": {
      "provider": "github"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "London.Live.Departures.Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.travel"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
