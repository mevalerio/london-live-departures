{
  "name": "london-live-departures",
  "productName": "London Live Departures",
  "version": "1.0.0",
  "description": "A beautiful, frameless desktop widget for live London Transport (TfL) and National Rail arrivals.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.github.london-live-departures",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "London.Live.Departures.Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.travel"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
