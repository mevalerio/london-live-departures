{
  "type": "APL",
  "version": "2023.2",
  "theme": "dark",
  "mainTemplate": {
    "parameters": [
      "defaultPayload"
    ],
    "item": {
      "type": "Container",
      "width": "100%",
      "height": "100%",
      "backgroundColor": "#111111",
      "paddingLeft": "16dp",
      "paddingRight": "16dp",
      "paddingTop": "16dp",
      "paddingBottom": "16dp",
      "items": [
        {
          "type": "Container",
          "direction": "row",
          "width": "100%",
          "justifyContent": "spaceBetween",
          "alignItems": "center",
          "paddingBottom": "5dp",
          "items": [
            {
              "type": "Text",
              "text": "${liveBoard.stationName ? liveBoard.stationName : (liveBoard.properties.stationName ? liveBoard.properties.stationName : (defaultPayload.stationName ? defaultPayload.stationName : (defaultPayload.defaultData.stationName ? defaultPayload.defaultData.stationName : defaultPayload.widgetData.properties.stationName)))}",
              "fontSize": "26dp",
              "color": "#FFFFFF",
              "fontWeight": "bold",
              "maxLines": 1,
              "shrink": 1
            },
            {
              "type": "TouchWrapper",
              "paddingLeft": "12dp",
              "paddingRight": "12dp",
              "paddingTop": "8dp",
              "paddingBottom": "8dp",
              "onPress": {
                "type": "SendEvent",
                "flags": {
                  "interactionMode": "INLINE"
                },
                "arguments": [
                  "RefreshWidget"
                ]
              },
              "item": {
                "type": "Text",
                "text": "REFRESH",
                "fontSize": "16dp",
                "color": "#00AAFF",
                "fontWeight": "bold"
              }
            }
          ]
        },
        {
          "type": "Sequence",
          "width": "100%",
          "height": "100%",
          "data": "${liveBoard.arrivals ? liveBoard.arrivals : (liveBoard.properties.arrivals ? liveBoard.properties.arrivals : (defaultPayload.arrivals ? defaultPayload.arrivals : (defaultPayload.defaultData.arrivals ? defaultPayload.defaultData.arrivals : defaultPayload.widgetData.properties.arrivals)))}",
          "item": [
            {
              "when": "${data.isHeader}",
              "type": "Text",
              "text": "${data.title}",
              "fontSize": "18dp",
              "color": "#AAAAAA",
              "fontWeight": "bold",
              "paddingTop": "12dp",
              "paddingBottom": "4dp"
            },
            {
              "type": "Container",
              "direction": "row",
              "width": "100%",
              "paddingTop": "4dp",
              "paddingBottom": "4dp",
              "justifyContent": "spaceBetween",
              "items": [
                {
                  "type": "Text",
                  "text": "${data.line} to ${data.destination}",
                  "fontSize": "18dp",
                  "color": "#FFD700",
                  "shrink": 1,
                  "maxLines": 1
                },
                {
                  "type": "Text",
                  "text": "${data.time}",
                  "fontSize": "20dp",
                  "color": "#00FF00",
                  "fontWeight": "bold"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "extensions": [
    {
      "name": "DataStore",
      "uri": "alexaext:datastore:10"
    }
  ],
  "settings": {
    "DataStore": {
      "dataBindings": [
        {
          "namespace": "LondonDepartures",
          "key": "liveBoard",
          "dataBindingName": "liveBoard",
          "dataType": "object"
        }
      ]
    }
  }
}